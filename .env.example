# Copy to .env and edit. NEVER commit .env.
# Location of AUTHORIZED real neuroimaging data (outside this repository).
# Windows example:  DATA_ROOT=D:/neuroimaging_data
# macOS/Linux:      DATA_ROOT=/Volumes/ExternalDrive/neuroimaging_data
DATA_ROOT=
# Optional: scratch directory for temporary per-subject processing (deleted after each subject)
WORK_DIR=
# Credentials are NOT used by this code. Download ADNI/OASIS data via their official portals.
